include "~/.cache/niri/overview-zoom.kdl"

prefer-no-csd
input {
  keyboard {
    xkb {
      layout "br"
    }
    repeat-delay 200
      repeat-rate 35
      numlock
  }
  touchpad {
    tap
    natural-scroll
  }
  focus-follows-mouse max-scroll-amount="0%"
}
output "eDP-1" {
    mode "1920x1080@60"
    position x=0 y=0
}
output "HDMI-A-1" {
    mode "1920x1080@60"
    position x=-1920 y=0

}
layout {
  gaps 2
  center-focused-column "never"
  preset-column-widths {
    proportion 0.25
    proportion 0.33333
    proportion 0.5
    proportion 0.66667
  }
  default-column-width { proportion 0.5; }
  focus-ring {
    width 2
    active-color "#414868"
    inactive-color "#283457"
  }
  struts {
    left 0
    right 0
    top 0
    bottom 0
  }
}

spawn-at-startup "awww-daemon"
spawn-at-startup "qs"
spawn-at-startup "xwayland-satellite"
spawn-at-startup "systemctl" "--user" "import-environment" "DISPLAY" "XAUTHORITY"
spawn-at-startup "mkdir -p ~/.cache/niri && echo 'overview { zoom 0.25; }' > ~/.cache/niri/overview-zoom.kdl"

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

binds {
  Mod+Q { close-window; }

  Mod+O { spawn "sh" "-c" "echo 'overview { zoom 0.5; }' > ~/.cache/niri/overview-zoom.kdl && niri msg action toggle-overview"; }
  Mod+Shift+O { spawn "~/zsh-scripts/niri-eagle-eye.sh"; }
  Mod+C { spawn "kitty" "--class" "qalc-popup" "qalc"; }
  Mod+E { spawn "kitty" "--class" "yazi-popup" "yazi"; }
  Mod+T { spawn "kitty"; }
  Mod+D { spawn "fuzzel"; }

  Mod+H     { focus-column-or-monitor-left; }
  Mod+J     { focus-workspace-down; }
  Mod+K     { focus-workspace-up; }
  Mod+L     { focus-column-or-monitor-right; }
  Mod+Ctrl+H { focus-monitor-left; }
  Mod+Ctrl+J { move-workspace-down; }
  Mod+Ctrl+K { move-workspace-up; }
  Mod+Ctrl+L { focus-monitor-right; }

  Mod+Shift+H     { move-column-left; }
  Mod+Shift+J     { move-window-to-workspace-down; }
  Mod+Shift+K     { move-window-to-workspace-up; }
  Mod+Shift+L     { move-column-right; }
  Mod+Shift+Ctrl+H { move-window-to-monitor-left; }
  Mod+Shift+Ctrl+L { move-window-to-monitor-right; }

  Mod+R { switch-preset-column-width; } 
  Mod+F { maximize-column; }
  Mod+Shift+F { fullscreen-window; }

  Mod+1 { focus-workspace 1; }
  Mod+2 { focus-workspace 2; }
  Mod+3 { focus-workspace 3; }
  Mod+4 { focus-workspace 4; }
  Mod+5 { focus-workspace 5; }
  Mod+6 { focus-workspace 6; }
  Mod+7 { focus-workspace 7; }
  Mod+8 { focus-workspace 8; }
  Mod+9 { focus-workspace 9; }
  Mod+0 { focus-workspace 0; }
  Mod+Shift+1 { move-window-to-workspace 1; }
  Mod+Shift+2 { move-window-to-workspace 2; }
  Mod+Shift+3 { move-window-to-workspace 3; }
  Mod+Shift+4 { move-window-to-workspace 4; }
  Mod+Shift+5 { move-window-to-workspace 5; }
  Mod+Shift+6 { move-window-to-workspace 6; }
  Mod+Shift+7 { move-window-to-workspace 7; }
  Mod+Shift+8 { move-window-to-workspace 8; }
  Mod+Shift+9 { move-window-to-workspace 9; }
  Mod+Shift+0 { move-window-to-workspace 0; }

  Mod+Shift+Ctrl+E { quit; }
  Mod+Shift+S { screenshot; }

  XF86AudioRaiseVolume   { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+" "-l" "1.5"; }
  XF86AudioLowerVolume   { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
  XF86AudioMute          { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
  "Ctrl+XF86AudioMute"  { spawn "zsh" "-c" "source ~/.zshrc && silence"; }
  XF86AudioMicMute       { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
  XF86MonBrightnessUp    { spawn "brightnessctl" "set" "5%+"; }
  XF86MonBrightnessDown  { spawn "brightnessctl" "set" "5%-"; }

  Super+Ctrl+Alt+L { spawn "hyprlock";}
  Super+Ctrl+Alt+P { power-off-monitors; }
  Mod+Space { toggle-window-floating; }
  Super+Alt+C     { center-window; }

  Mod+N { spawn "qs" "ipc" "call" "notifications" "toggle"; }
}
window-rule {
  geometry-corner-radius 0
  clip-to-geometry true
  match title="^Geometry Dash$"; open-fullscreen true;
}
window-rule {
  match app-id="[Ss]potify$"
  open-maximized true
}
window-rule {
    match app-id="qalc-popup"
    open-floating true
    default-column-width { fixed 1280; }
    default-window-height { fixed 720; }
}
window-rule {
    match app-id="ibus"
    open-floating true
}
hotkey-overlay {
  skip-at-startup
}
debug {
  honor-xdg-activation-with-invalid-serial
}
